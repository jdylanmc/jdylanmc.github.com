---
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Dylan McCurry — engineering manager to an AI." } = Astro.props;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/resume", label: "Resume" },
  { href: "/links", label: "Links" },
];
const currentPath = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Serif:wght@400;600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Courier+Prime:wght@400;700&family=Source+Serif+4:wght@400;600&family=Space+Grotesk:wght@500;700&family=Space+Mono:wght@400;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var STORAGE_KEY = "site-theme";
        var DEFAULT_THEME = "terminal";
        var stored = null;
        try {
          stored = localStorage.getItem(STORAGE_KEY);
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", stored || DEFAULT_THEME);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">dylan mccurry</a>
        <nav class="nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>&copy; {new Date().getFullYear()} Dylan McCurry</span>
        <span>
          <a href="https://github.com/jdylanmc" target="_blank" rel="noreferrer">GitHub</a>
          &middot;
          <a href="/links">All links</a>
        </span>
      </div>
    </footer>
  </body>
</html>
