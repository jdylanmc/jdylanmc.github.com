---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog — Dylan McCurry">
  <span class="eyebrow">Blog</span>
  <h1>Writing</h1>
  <div>
    {posts.map((post) => (
      <div class="chunk">
        <span class="tag">{post.data.pubDate.toISOString().slice(0, 10)}</span>
        <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
        {post.data.description && <p class="muted">{post.data.description}</p>}
      </div>
    ))}
  </div>
  {posts.length === 0 && <p class="muted">Nothing here yet — check back soon.</p>}
</Layout>
