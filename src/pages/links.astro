---
import Layout from "../layouts/Layout.astro";

const links = [
  { label: "GitHub", href: "https://github.com/jdylanmc" },
  { label: "CMUX Maestro (repo)", href: "https://github.com/jdylanmc/cmux-maestro" },
  { label: "PR Sniper (repo)", href: "https://github.com/jdylanmc/pr-sniper" },
  { label: "Dotfiles (repo)", href: "https://github.com/jdylanmc/dotfiles" },
  { label: "Cacophony (repo)", href: "https://github.com/jdylanmc/cacophony" },
  { label: "Topocode", href: "https://jdylanmc.github.io/topo-code/" },
  { label: "JS Particle Engine (repo)", href: "https://github.com/jdylanmc/JS-Particle-Engine" },
  { label: "Wikipedia Visualization (repo)", href: "https://github.com/jdylanmc/Wikipedia-Visualization" },
  { label: "Interactive US Map (CodePen)", href: "https://codepen.io/jdylanmc/pen/MWjPjdE" },
];
---

<Layout title="Links — Dylan McCurry">
  <span class="eyebrow">Links</span>
  <h1>Elsewhere</h1>
  <div class="card-grid">
    {links.map((l) => (
      <a class="card" href={l.href} target="_blank" rel="noreferrer">
        <h3>{l.label} ↗</h3>
      </a>
    ))}
  </div>
</Layout>
