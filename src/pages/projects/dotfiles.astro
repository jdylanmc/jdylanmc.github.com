---
import Layout from "../../layouts/Layout.astro";

const chunks = [
  {
    title: "home/.zshenv",
    tag: "Every Zsh invocation",
    path: "~/.zshenv",
    lines: `export PATH="$HOME/.local/bin:$PATH"`,
    what: "One line. Fix PATH. Run every shell, no matter what.",
    why: "Script shell no need prompt, no need plugin. Just need PATH right. Put heavy stuff elsewhere, this file stay fast.",
  },
  {
    title: "home/.zshrc",
    tag: "Interactive shell",
    path: "~/.zshrc",
    lines: `plugins=(
  git
  brew
  yarn
  nvm
  docker
  docker-compose
  zsh-autosuggestions
  zsh-syntax-highlighting
)
...
eval "$(starship init zsh)"`,
    what: "Big file. Plugins, prompt, aliases, account-switch brain. Where shell get personality.",
    why: "Only human eyeball this one when thing feel weird. Keep all the 'make terminal nice' stuff in one place, not scattered.",
  },
  {
    title: "home/.gitconfig",
    tag: "Identity-free, shared",
    path: "~/.gitconfig",
    lines: `[user]
  useConfigOnly = true

[core]
  editor = code --wait
  pager = delta

[interactive]
  diffFilter = delta --color-only`,
    what: "Git behave good. Pretty diffs. No name, no email inside.",
    why: "No identity in this file means safe to show whole world. Identity hide in other files, never pushed.",
  },
  {
    title: "~/.gitconfig.personal / .work / .local",
    tag: "Untracked, mode 0600",
    path: "~/.gitconfig.local",
    lines: `[include]
  path = ~/.gitconfig.local

[includeIf "gitdir:~/git/_opensource/"]
  path = ~/.gitconfig.personal`,
    what: "Three secret files. Installer make them, Git never commit them. One for personal, one for work, one picks which.",
    why: "Name and email too risky for public repo. Keep private files on disk only, folder decides which identity apply.",
  },
  {
    title: "home/.config/starship.toml",
    tag: "Prompt",
    path: "~/.config/starship.toml",
    lines: `"$schema" = 'https://starship.rs/config-schema.json'
add_newline = false

[aws]
symbol = " "

[battery]
discharging_symbol = "󰂃 "`,
    what: "Prompt config. Own file, not stuffed in .zshrc.",
    why: "Prompt look same on every machine. No identity stuff needed to make it pretty.",
  },
  {
    title: "scripts/setup-git.sh",
    tag: "Guided setup",
    path: "~/.dotfiles/scripts/setup-git.sh",
    lines: `#!/usr/bin/env bash
set -euo pipefail

source "$ROOT/scripts/lib/install.sh"
source "$ROOT/scripts/install/git.sh"

init_install
setup_git_guided`,
    what: "Ask questions. Set up Git identity. Run after install.",
    why: "Work identity stay off until personal identity exist first. No accident leak into open-source folder.",
  },
  {
    title: "ghwho / ghuse",
    tag: "Account routing (in .zshrc)",
    path: "~/.zshrc",
    lines: `ghwho() {
  print "\${_GH_ACCOUNT:-none} (from directory profile)"
}

ghuse() {
  export GH_TOKEN="$(GH_TOKEN= gh auth token -u "$1")"
  export _GH_ACCOUNT="$1"
  export _GH_ACCOUNT_PINNED="$1"
}`,
    what: "Two function. ghwho say who you are. ghuse pin different account.",
    why: "Many GitHub account, one machine. Token swap per-shell so two terminal no fight over same account.",
  },
  {
    title: "scripts/check-public.sh",
    tag: "Pre-commit / pre-push",
    path: "~/.dotfiles/scripts/check-public.sh",
    lines: `blocked_paths='(\\.env|\\.npmrc|credentials|secrets|\\.ssh/|\\.aws/)'
secret_patterns='(AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|-----BEGIN.*PRIVATE KEY-----)'
work_patterns='(microsoft|xbox|xgang|fresno|garrison)'`,
    what: "Robot hook. Scan every commit and push for secret, key, work word.",
    why: "Human forget. Machine no forget. Bad thing blocked before it leave laptop.",
  },
  {
    title: "install.sh",
    tag: "Entry point",
    path: "~/.dotfiles/install.sh",
    lines: `#!/usr/bin/env bash
set -euo pipefail

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --no-brew) use_brew=0; shift ;;
    --with-maestro) with_maestro=1; shift ;;
    --no-git-setup) git_setup=0; shift ;;
  esac
done`,
    what: "One script. Run once. New Mac become old Mac.",
    why: "No checklist in head. No forgotten step. Same script, same result, every machine.",
  },
];
---

<Layout title="Dotfiles — Dylan McCurry">
  <span class="eyebrow">Project</span>
  <h1>Dotfiles</h1>
  <p class="muted">
    Public, source-controlled macOS development configuration. Files under <code>home/</code> are
    authoritative and symlinked straight into <code>$HOME</code> — editing a linked file edits the
    repository copy, so there's never a drift between "what's documented" and "what's running."
  </p>
  <div style="margin-bottom: 1.5rem;">
    <span class="tag">Shell</span>
    <span class="tag">Zsh</span>
    <span class="tag">Git</span>
    <span class="tag">Homebrew</span>
  </div>
  <a class="btn" href="https://github.com/jdylanmc/dotfiles" target="_blank" rel="noreferrer">View on GitHub ↗</a>

  <h2>Fresh Mac</h2>
  <pre><code>git clone https://github.com/jdylanmc/dotfiles.git ~/.dotfiles
cd ~/.dotfiles
./install.sh --with-maestro</code></pre>
  <p class="muted">
    Use <code>--no-brew</code> to skip package installation, omit <code>--with-maestro</code> to
    install only dotfiles, or <code>--no-git-setup</code> to skip guided Git identity prompts.
  </p>

  <h2>Chunk by chunk</h2>
  <p class="muted">What each part is for, and why it's structured that way.</p>

  <div>
    {chunks.map((c) => (
      <div class="chunk">
        <div class="chunk-head">
          <h3><code>{c.title}</code></h3>
          <button class="copy-btn" type="button" data-copy={c.path} aria-label={`Copy path ${c.path}`}>
            <span class="copy-label">{c.path}</span>
            <span class="copy-action">Copy</span>
          </button>
        </div>
        <span class="tag">{c.tag}</span>
        <pre class="chunk-lines"><code>{c.lines}</code></pre>
        <div class="chunk-ww">
          <div>
            <span class="chunk-wlabel">What</span>
            <p class="muted">{c.what}</p>
          </div>
          <div>
            <span class="chunk-wlabel">Why</span>
            <p class="muted">{c.why}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <h2>Why separate from Maestro</h2>
  <p>
    The reusable coding-agent workspace lives separately in
    <a href="https://github.com/jdylanmc/maestro" target="_blank" rel="noreferrer">jdylanmc/maestro</a>.
    Until Maestro v2 ships, <code>--with-maestro</code> installs its preserved <code>proto-v1</code>
    launcher — dotfiles owns personal shell/terminal preferences, not agent orchestration.
  </p>

  <a class="btn btn--ghost" href="/projects">&larr; Back to projects</a>

  <style>
    .chunk-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }
    .chunk-head h3 {
      margin: 0;
    }
    .copy-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      background: var(--bg);
      color: var(--fg-muted);
      border: var(--border-width) solid var(--border);
      border-radius: calc(var(--radius) / 2 + 2px);
      padding: 0.3rem 0.5rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .copy-btn:hover {
      border-color: var(--accent);
      color: var(--fg);
    }
    .copy-btn .copy-action {
      font-weight: 700;
      color: var(--accent);
    }
    .copy-btn.copied .copy-action {
      color: var(--fg);
    }
    .chunk-ww {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-top: 0.75rem;
    }
    .chunk-wlabel {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 0.25rem;
    }
    .chunk-lines {
      margin: 0.75rem 0;
      font-size: 0.82rem;
    }
  </style>

  <script>
    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const value = btn.dataset.copy || "";
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const ta = document.createElement("textarea");
          ta.value = value;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          ta.remove();
        }
        const action = btn.querySelector(".copy-action");
        const original = action?.textContent;
        if (action) action.textContent = "Copied!";
        btn.classList.add("copied");
        setTimeout(() => {
          if (action && original) action.textContent = original;
          btn.classList.remove("copied");
        }, 1500);
      });
    });
  </script>
</Layout>
