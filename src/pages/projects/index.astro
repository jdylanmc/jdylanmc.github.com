---

<Layout title="Projects — Dylan McCurry">
  <h1>Projects</h1>
  <p class="muted">A timeline of what I've actually worked on, most recent first.</p>

  <div class="timeline">
    {timeline.map((item, i) => (
      <div class={`timeline-item ${i % 2 === 0 ? "timeline-item--left" : "timeline-item--right"}`}>
        <div class="timeline-dot"></div>
        {item.milestone ? (
          <div class="chunk timeline-card timeline-milestone">
            <h3>{item.thing}</h3>
            <p class="muted">{item.desc}</p>
            <span class="timeline-year">{item.year}</span>
          </div>
        ) : (
          <div class={`chunk timeline-card ${item.year === "Now" ? "timeline-now" : ""}`}>
            <div class="timeline-labels">
              <span class="tag">{item.org}</span>
              <span class="tag">{item.role}</span>
            </div>
            <h3>{item.thing}</h3>
            {item.period && <p class="muted timeline-period">{item.period}</p>}
            <p class="muted">{item.desc}</p>
            {item.links && (
              <div class="timeline-links">
                {item.links.map((l) => (
                  <a
                    class="btn"
                    href={l.href}
                    target={l.external ? "_blank" : undefined}
                    rel={l.external ? "noreferrer" : undefined}
                  >
                    {l.label}{l.external ? " ↗" : ""}
                  </a>
                ))}
              </div>
            )}
            <span class="timeline-year">{item.year}</span>
          </div>
        )}
      </div>
    ))}
  </div>
</Layout>

<style>
  .timeline {
    position: relative;
    margin: 3rem 0;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    width: 50%;
    padding-bottom: 2rem;
  }

  .timeline-item--left {
    left: 0;
    padding-right: 2.5rem;
  }

  .timeline-item--right {
    left: 50%;
    padding-left: 2.5rem;
  }

  .timeline-dot {
    position: absolute;
    top: 0.35rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: 0 0 0 2px var(--border);
  }

  .timeline-item--left .timeline-dot {
    right: -8px;
  }

  .timeline-item--right .timeline-dot {
    left: -8px;
  }

  .timeline-labels {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .timeline-card h3 {
    text-transform: none;
    margin-bottom: 0.15rem;
  }

  .timeline-period {
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .timeline-card {
    margin: 0;
    position: relative;
    padding-bottom: 1.75rem;
  }

  .timeline-milestone {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }

  .timeline-milestone h3 {
    color: var(--accent);
  }

  .timeline-now {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, var(--bg));
    box-shadow: 0 0 0 1px var(--accent);
  }

  .timeline-year {
    position: absolute;
    bottom: 0.6rem;
    right: 0.9rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    opacity: 0.7;
  }

  .timeline-links {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .timeline::before {
      left: 7px;
    }

    .timeline-item,
    .timeline-item--left,
    .timeline-item--right {
      width: 100%;
      left: 0;
      padding-left: 2rem;
      padding-right: 0;
    }

    .timeline-item--left .timeline-dot,
    .timeline-item--right .timeline-dot {
      left: 0;
      right: auto;
    }
  }
</style>
