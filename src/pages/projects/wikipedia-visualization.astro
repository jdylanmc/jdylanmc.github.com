---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Wikipedia Visualization — Dylan McCurry">
  <span class="eyebrow">Look what I built, long before AI was a thing</span>
  <h1>Wikipedia Visualization</h1>
  <p class="muted">
    A force-directed 3D graph explorer built during graduate school at MTSU (Middle Tennessee State
    University) in 2011. Search any topic, and it pulls live Wikipedia data, extracts outbound
    links, and renders an interactive Three.js graph you can click through.
  </p>
  <div style="margin-bottom: 1.5rem;">
    <span class="tag">Three.js</span>
    <span class="tag">Wikipedia API</span>
    <span class="tag">2011</span>
  </div>
  <a class="btn" href="https://github.com/jdylanmc/Wikipedia-Visualization" target="_blank" rel="noreferrer">View on GitHub ↗</a>

  <h2>Live demo</h2>
  <p class="muted">
    Type a topic and hit Go. Click any node to expand its links. Rotate with the left mouse
    button, hold S to zoom, hold D to drag. Rendered directly on this page — no iframe.
  </p>

  <link rel="stylesheet" href="/demos/wikipedia-viz/css/embed/style-scoped.css" />

  <div class="wv-embed" id="wv-stage" style="height: 620px;">
    <div id="options">
      <div class="box-outter">
        <div class="box-inner">
          <form onsubmit="WIKI_parse(); return false;">
            <p>
              <h3>Wikipedia Visualization</h3>
              Type in the box below to search for a topic on Wikipedia. The topic and first 7
              associated links will be displayed as nodes. Click a node to further expand it's
              links.
            </p>
            <input type="text" id="input-text" />
            <input type="button" value="Go" id="go-button" />
          </form>
        </div>
      </div>
      <div class="box-outter">
        <div class="box-inner">
          <table align="center">
            <tr>
              <td><input type="button" value="Pause" onclick="Pause();" class="control-button" /></td>
            </tr>
            <tr>
              <td><input type="button" value="Adjust" onclick="Adjust();" class="control-button" /></td>
            </tr>
          </table>
        </div>
      </div>
      <div class="box-outter">
        <div class="box-inner">
          <p>
            <h3>Stats:</h3>
            <div id="graph-info"></div>
          </p>
        </div>
      </div>
      <div class="box-outter">
        <div class="box-inner">
          <h3>Controls</h3>
          <table>
            <tr>
              <td>Rotate:</td>
              <td>Left Mouse Button</td>
            </tr>
            <tr>
              <td>Zoom:</td>
              <td>S + Left Mouse Button</td>
            </tr>
            <tr>
              <td>Drag:</td>
              <td>D + Left Mouse Button</td>
            </tr>
          </table>
        </div>
      </div>
      <div class="box-outter">
        <div class="box-inner">
          <p>
            Created for a graduate course at MTSU, circa 2011. This project uses Three.js for
            rendering, and was inspired by a framework created by
            <a href="https://github.com/davidpiegza/Graph-Visualization" target="_blank" rel="noreferrer">David Piegza</a>.
          </p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://ajax.googleapis.com/ajax/libs/jquery/1.6/jquery.min.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/Three.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/simple_graph.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/force-directed-layout.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/Label.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/ObjectSelection.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/requestAnimationFrame.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/Stats.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/Graph.js"></script>
  <script is:inline src="/demos/wikipedia-viz/scripts/Wikipedia.js"></script>

  <a class="btn btn--ghost" href="/">&larr; Back to home</a>
</Layout>
