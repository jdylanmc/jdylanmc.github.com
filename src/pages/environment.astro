---
import Layout from "../layouts/Layout.astro";

const dotfiles = {
  href: "/projects/dotfiles",
  title: "Dotfiles",
  tags: ["Shell", "Zsh", "Git"],
  description:
    "The whole environment, explained chunk by chunk: what's linked into $HOME, why it's structured that way, and how identities route.",
};

const builtOnTop = [
  {
    href: "/projects/cmux-maestro",
    title: "CMUX Maestro",
    tags: ["Swift", "macOS", "ExtensionKit"],
    description:
      "The orchestration plugin for CMUX — a sidebar surface for multi-agent visibility, built as a sandboxed ExtensionKit boundary.",
  },
  {
    href: "/projects/pr-sniper",
    title: "PR Sniper",
    tags: ["Tauri", "Rust", "TypeScript"],
    description:
      "A macOS menu-bar app for human-owned pull request review — a queue, assigned agent review, and a publication gate a human controls.",
  },
  {
    href: "/projects/cacophony",
    title: "Cacophony",
    tags: ["GitHub Actions", "Azure AI Foundry"],
    description:
      "Adversarial pull request review from prompt-defined agent lenses — six reviewer personas, bounded read-only tools, one canonical report.",
  },
];

const forkedAndAdapted = [
  {
    href: "https://github.com/jdylanmc/notch",
    title: "Notch",
    tags: ["Swift", "macOS", "Fork"],
    description: "Forked an upstream app and hacked it into my own thing.",
    external: true,
  },
  {
    href: "https://github.com/jdylanmc/agent-skills",
    title: "Agent Skills",
    tags: ["Markdown", "Process"],
    description: "How I actually think about software development now.",
    external: true,
  },
];
---

<Layout title="Environment — Dylan McCurry">
  <span class="eyebrow">Environment</span>
  <h1>This is what I actually run</h1>
  <p class="muted">
    Dotfiles, cacophony, maestro, PR sniper, notch, skills — it's all my agentic repos and
    agentic environment.
  </p>

  <span class="eyebrow">The foundation</span>
  <h2>It all runs on dotfiles</h2>
  <div class="card-grid">
    <a class="card" href={dotfiles.href}>
      <h3>{dotfiles.title}</h3>
      <p class="muted">{dotfiles.description}</p>
      <div>
        {dotfiles.tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </a>
  </div>

  <hr />

  <h2>Built on top of it</h2>
  <div class="card-grid">
    {builtOnTop.map((p) => (
      <a class="card" href={p.href}>
        <h3>{p.title}</h3>
        <p class="muted">{p.description}</p>
        <div>
          {p.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>

  <hr />

  <h2>Forked and adapted</h2>
  <div class="card-grid">
    {forkedAndAdapted.map((p) => (
      <a class="card" href={p.href} target="_blank" rel="noreferrer">
        <h3>{p.title} ↗</h3>
        <p class="muted">{p.description}</p>
        <div>
          {p.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Layout>
